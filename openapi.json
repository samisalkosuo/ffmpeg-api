{
  "openapi": "3.1.0",
  "info": {
    "title": "FFMPEG API",
    "summary": "REST API for converting audio, video and image files with FFmpeg.",
    "description": "\nConvert audio, video and image files with [FFmpeg](https://ffmpeg.org/) over HTTP.\n\n* Upload a file as `multipart/form-data` (form field `file`, exactly one file).\n* Conversion endpoints return the converted file as the response body.\n* Extract endpoints return audio, images or an archive of images from a video.\n* `POST /probe` returns the media metadata as JSON.\n\nThe service has no authentication. Run it in a trusted network or behind a reverse proxy.\n",
    "contact": {
      "name": "ffmpeg-api on GitHub",
      "url": "https://github.com/samisalkosuo/ffmpeg-api"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "2.0.0"
  },
  "paths": {
    "/convert/audio/to/mp3": {
      "post": {
        "tags": [
          "Convert"
        ],
        "summary": "Convert audio to MP3",
        "description": "Converts an audio file to MP3 with the `libmp3lame` encoder.",
        "operationId": "convertAudioToMp3",
        "requestBody": {
          "description": "Multipart form with exactly one file. Non-file fields are rejected.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Any file that FFmpeg can read."
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The MP3 file.",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Bad request: not a multipart upload, no file, or a non-file field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File is larger than FILE_SIZE_LIMIT_BYTES.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "FFmpeg failed, for example because the input is not valid media.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
