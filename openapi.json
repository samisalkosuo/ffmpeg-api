    "/video/extract/images": {
      "post": {
        "tags": [
          "Extract"
        ],
        "summary": "Extract images (frames) from a video",
        "description": "Extracts frames of a video as PNG images, 1 frame per second by default.\n\nWithout `compress` the response is JSON that lists a download URL for each image (see `GET /video/extract/download/{filename}`). With `compress=zip` or `compress=gzip` the response is a ZIP or tar.gz archive of all images.",
        "operationId": "extractImages",
        "parameters": [
          {
            "name": "fps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Frames per second to extract. 0.5 is one image every 2 seconds.",
              "default": 1,
              "title": "Fps"
            },
            "description": "Frames per second to extract. 0.5 is one image every 2 seconds."
          },
          {
            "name": "compress",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "zip",
                    "gzip"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Return all images as a `zip` or `gzip` (tar.gz) archive.",
              "title": "Compress"
            },
            "description": "Return all images as a `zip` or `gzip` (tar.gz) archive."
          }
        ],
        "responses": {
          "200": {
            "description": "JSON list of images, or an archive when `compress` is used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractedImages"
                }
              },
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/gzip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Bad request: not a multipart upload, no file, or a non-file field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File is larger than FILE_SIZE_LIMIT_BYTES.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "FFmpeg failed, for example because the input is not valid media.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "Multipart form with exactly one file. Non-file fields are rejected.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Any file that FFmpeg can read."
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "/video/extract/download/{filename}": {
      "get": {
        "tags": [
          "Extract"
        ],
        "summary": "Download an extracted image or archive",
        "description": "Downloads a file created by `POST /video/extract/images`. The file is deleted from the server after the download, unless `delete=no` is used.",
        "operationId": "downloadExtractedFile",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "File name from the extract images response.",
              "examples": [
                "ba0f565c-0001.png"
              ],
              "title": "Filename"
            },
            "description": "File name from the extract images response."
          },
          {
            "name": "delete",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "`no` keeps the file on the server. Default is to delete it.",
              "default": "true",
              "title": "Delete"
            },
            "description": "`no` keeps the file on the server. Default is to delete it."
          }
        ],
        "responses": {
          "200": {
            "description": "The file.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/gzip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "No such file."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/probe": {
      "post": {
        "tags": [
          "Probe"
        ],
        "summary": "Probe a media file",
        "description": "Returns the metadata of an audio, video or image file. The result is the same JSON as `ffprobe -of json -show_streams -show_format -show_chapters <file>`.",
        "operationId": "probeMedia",
        "requestBody": {
          "description": "Multipart form with exactly one file. Non-file fields are rejected.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Any file that FFmpeg can read."
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request: not a multipart upload, no file, or a non-file field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File is larger than FILE_SIZE_LIMIT_BYTES.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "FFmpeg failed, for example because the input is not valid media.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/endpoints": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "List service endpoints",
        "description": "Returns the endpoints of the service as JSON.",
        "operationId": "listEndpoints",
        "responses": {
          "200": {
            "description": "Successful Response",
