    "/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Health check",
        "description": "Returns `{\"status\": \"ok\"}` when the service is running. Used by the container health check.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Endpoint": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "examples": [
              "/convert/audio/to/mp3"
            ]
          },
          "methods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Methods",
            "examples": [
              [
                "POST"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "path",
          "methods"
        ],
        "title": "Endpoint"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Human readable error message."
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "examples": [
          {
            "error": "route not found"
          }
        ]
      },
      "ExtractedImage": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "File name of the extracted image.",
            "examples": [
              "ba0f565c-0001.png"
            ]
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "URL for downloading the image. Downloading deletes the image from the server unless `delete=no` is used.",
            "examples": [
              "http://127.0.0.1:3000/video/extract/download/ba0f565c-0001.png"
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "title": "ExtractedImage"
      },
      "ExtractedImages": {
        "properties": {
          "totalfiles": {
            "type": "integer",
            "title": "Totalfiles",
            "description": "Number of extracted images.",
            "examples": [
              5
            ]
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Human readable note about the download URLs."
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/ExtractedImage"
            },
            "type": "array",
            "title": "Files",
            "description": "Extracted images, in frame order."
          }
        },
        "type": "object",
        "required": [
          "totalfiles",
          "description",
          "files"
        ],
        "title": "ExtractedImages"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProbeResult": {
        "properties": {
          "streams": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Streams",
            "description": "One entry per stream."
          },
          "chapters": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Chapters",
            "description": "Chapters, if any."
          },
          "format": {
            "additionalProperties": true,
            "type": "object",
            "title": "Format",
            "description": "Container information."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "ProbeResult",
        "description": "Output of `ffprobe -of json -show_streams -show_format -show_chapters`.",
        "examples": [
          {
            "chapters": [],
            "format": {
              "bit_rate": "1782208",
              "duration": "60.056000",
              "filename": "/tmp/5f69ae62-input.mov",
              "format_name": "mov,mp4,m4a,3gp,3g2,mj2",
              "nb_streams": 2,
              "size": "13379040"
            },
            "streams": [
              {
                "codec_name": "h264",
                "codec_type": "video",
                "height": 720,
                "index": 0,
                "width": 1280
              },
              {
                "channels": 2,
                "codec_name": "aac",
                "codec_type": "audio",
                "index": 1,
                "sample_rate": "48000"
              }
            ]
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
